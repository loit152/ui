	<script>
	// メニュー関連のJS
	let menuButton = document.querySelector(".openbtn1");
	let sideBar = document.getElementById("as-side-bar");
	menuButton.addEventListener('click',()=>{
		menuButton.classList.toggle("active");
		sideBar.classList.toggle("active");
	});

	//サイドバーメニュー　アクティブなページに色をつける
	let sideMenuItems=document.querySelectorAll(".nav-item");
	sideMenuItems.forEach(e=>{
		e.children[0].classList.remove("active");
		e.children[0].classList.add("link-dark");
		if(e.children[0].textContent.trim()==document.title.split(':')[0]) {
			e.children[0].classList.add("active");
			e.children[0].classList.remove("link-dark");
		}
	});
	</script>

